# Prefer a fine-grained token limited to the repositories this MCP may manage.
GITHUB_TOKEN=

# Use the platform path delimiter: semicolon on Windows, colon on macOS/Linux.
GITHUB_MCP_ALLOWED_ROOTS=E:\projects;C:\Users\your-name\Documents\projects

# Used only when Git has no configured commit identity.
GITHUB_MCP_GIT_NAME=Your Name
GITHUB_MCP_GIT_EMAIL=you@example.com

# Optional custom Git executable and GitHub Enterprise API endpoint.
GITHUB_MCP_GIT_PATH=git
GITHUB_API_URL=https://api.github.com
